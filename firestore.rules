rules_version = '2';

// Firestore security rules for CollabBoard.
// Paste into Firebase console -> Firestore Database -> Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    match /artifacts/{appId}/public/data/rooms/{roomId} {
      // Anyone signed in to the app (anonymous sign-in) can view a board.
      allow read: if request.auth != null;

      // The creator must record themselves as host.
      allow create: if request.auth != null
        && request.resource.data.hostId == request.auth.uid;

      allow update: if request.auth != null && (
        // The host can change anything on their own board.
        resource.data.hostId == request.auth.uid
        // Anyone can join (only the participants list changes), even when locked.
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants'])
        // Collaborators can edit an unlocked board, but not take over host or lock settings.
        || (resource.data.get('isLocked', false) == false
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['hostId', 'hostSessionId', 'hostName', 'isLocked', 'roomId', 'createdAt']))
      );

      allow delete: if false;

      // Live chat messages for a board.
      match /chat/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;
        allow update, delete: if false;
      }
    }
  }
}
